{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestMod section",
  "description": "data/<namespace>/questmod/sections/<name>.json",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "description": "Section name. Start with $ to use a language key." },
    "icon": { "type": "string", "description": "Item id, or a .png texture path (mypack:textures/gui/section/create.png)." },
    "order": { "type": "integer", "default": 0, "description": "Lower shows first." }
  }
}
